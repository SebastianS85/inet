  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\my_board && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe -P cmake_install.cmake"
