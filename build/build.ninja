  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\driver && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/driver/install: phony esp-idf/driver/CMakeFiles/install.util


#############################################
# Utility command for install/local

