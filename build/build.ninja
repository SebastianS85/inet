  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\unity && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SC:\esp_projects\inetRadio -BC:\esp_projects\inetRadio\build"
