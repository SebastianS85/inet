build esp-idf/esp-sr/CMakeFiles/install/local.util: CUSTOM_COMMAND esp-idf/esp-sr/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\esp-sr && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
