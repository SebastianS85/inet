# Utility command for install/strip

build esp-idf/protocomm/CMakeFiles/install/strip.util: CUSTOM_COMMAND esp-idf/protocomm/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\protocomm && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe -DCMAKE_INSTALL_DO_STRIP=1 -P cmake_install.cmake"
  DESC = Installing the project stripped...
  pool = console
  restat = 1

build esp-idf/protocomm/install/strip: phony esp-idf/protocomm/CMakeFiles/install/strip.util

