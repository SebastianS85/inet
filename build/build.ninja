build esp-idf/my_board/libmy_board.a: C_STATIC_LIBRARY_LINKER____idf_my_board_ esp-idf/my_board/CMakeFiles/__idf_my_board.dir/my_board_v1_0/board.c.obj esp-idf/my_board/CMakeFiles/__idf_my_board.dir/my_board_v1_0/board_pins_config.c.obj esp-idf/my_board/CMakeFiles/__idf_my_board.dir/my_codec_driver/new_codec.c.obj || esp-idf/audio_sal/libaudio_sal.a esp-idf/console/libconsole.a esp-idf/esp-adf-libs/libesp-adf-libs.a esp-idf/esp_dispatcher/libesp_dispatcher.a esp-idf/esp_lcd/libesp_lcd.a esp-idf/espressif__nghttp/libespressif__nghttp.a esp-idf/fatfs/libfatfs.a esp-idf/spiffs/libspiffs.a esp-idf/wear_levelling/libwear_levelling.a esp-idf/xtensa/libxtensa.a
  LANGUAGE_COMPILE_FLAGS = -mlongcalls  -fno-builtin-memcpy -fno-builtin-memset -fno-builtin-bzero -fno-builtin-stpcpy -fno-builtin-strncpy
  OBJECT_DIR = esp-idf\my_board\CMakeFiles\__idf_my_board.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = esp-idf\my_board\CMakeFiles\__idf_my_board.dir\__idf_my_board.pdb
  TARGET_FILE = esp-idf\my_board\libmy_board.a
  TARGET_PDB = esp-idf\my_board\libmy_board.pdb


#############################################
# Utility command for edit_cache

build esp-idf/my_board/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\my_board && C:\esp\tools\tools\cmake\3.30.2\bin\cmake-gui.exe -SC:\esp_projects\inetRadio -BC:\esp_projects\inetRadio\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/my_board/edit_cache: phony esp-idf/my_board/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/my_board/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\my_board && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SC:\esp_projects\inetRadio -BC:\esp_projects\inetRadio\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/my_board/rebuild_cache: phony esp-idf/my_board/CMakeFiles/rebuild_cache.util


#############################################
