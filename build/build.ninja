# Utility command for edit_cache

build esp-idf/freertos/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\freertos && C:\esp\tools\tools\cmake\3.30.2\bin\cmake-gui.exe -SC:\esp_projects\inetRadio -BC:\esp_projects\inetRadio\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build esp-idf/freertos/edit_cache: phony esp-idf/freertos/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build esp-idf/freertos/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\freertos && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe --regenerate-during-build -SC:\esp_projects\inetRadio -BC:\esp_projects\inetRadio\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build esp-idf/freertos/rebuild_cache: phony esp-idf/freertos/CMakeFiles/rebuild_cache.util


