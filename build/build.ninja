build esp-idf/esp-sr/CMakeFiles/install.util: CUSTOM_COMMAND esp-idf/esp-sr/all
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\esp_projects\inetRadio\build\esp-idf\esp-sr && C:\esp\tools\tools\cmake\3.30.2\bin\cmake.exe -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build esp-idf/esp-sr/install: phony esp-idf/esp-sr/CMakeFiles/install.util


#############################################
